{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rugradar",
  "account_id": "ea2eb3a9813660dfca2a60e594858538",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "MEMESCANNER_CACHE",
      "id": "a4486b07fcce49f08ddee721bbef50e2",
    },
  ],
  "ratelimits": [
    {
      "name": "SCAN_RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  // Custom domain off trademetricspro.com (zone must be active on this
  // account; deploy auto-creates the DNS record).
  "routes": [
    { "pattern": "rugradar.trademetricspro.com", "custom_domain": true },
  ],
  // Keep the workers.dev subdomain alive alongside the custom domain.
  "workers_dev": true,
}
