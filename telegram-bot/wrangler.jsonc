{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rugradar-bot",
  "account_id": "ea2eb3a9813660dfca2a60e594858538",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  // TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET are Worker secrets:
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN
  //   npx wrangler secret put TELEGRAM_WEBHOOK_SECRET
  // Never commit them here. See setup.md.
  "kv_namespaces": [
    {
      "binding": "MEMESCANNER_CACHE",
      // Shared Deathwatch namespace (schema: docs/DEATHWATCH.md) — used for
      // the tg:subs subscriber list.
      "id": "a4486b07fcce49f08ddee721bbef50e2"
    }
  ]
}
